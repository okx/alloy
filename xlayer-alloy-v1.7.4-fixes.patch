From 4318bd91cb6fc18c36915798b74b88fcfbdb014f Mon Sep 17 00:00:00 2001
From: Vui-Chee <vuicheesiew@gmail.com>
Date: Wed, 25 Mar 2026 11:56:03 +0800
Subject: [PATCH 1/3] fix(deps): upgrade jsonwebtoken to 10.3.0
 (CVE-2026-25537)

Bump jsonwebtoken workspace dependency from 9.3.0 to 10.3.0 to address
CVE-2026-25537. jsonwebtoken 10.x drops the `ring` backend in favour of
pure-Rust crypto crates; enable the `rust_crypto` feature on the `jwt`
feature of alloy-rpc-types-engine so the new backend is selected.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 Cargo.toml                         | 2 +-
 crates/rpc-types-engine/Cargo.toml | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index e9d81135..900febe9 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -152,7 +152,7 @@ derive_more = { version = "2", default-features = false }
 either = { version = "1.15", default-features = false }
 http = "1.1.0"
 itertools = { version = ">=0.13, <=0.14", default-features = false }
-jsonwebtoken = "9.3.0"
+jsonwebtoken = { version = "10.3.0", default-features = false }
 lru = "0.16"
 once_cell = { version = "1.21", default-features = false }
 parking_lot = "0.12.3"
diff --git a/crates/rpc-types-engine/Cargo.toml b/crates/rpc-types-engine/Cargo.toml
index 49ae7640..1d4694b4 100644
--- a/crates/rpc-types-engine/Cargo.toml
+++ b/crates/rpc-types-engine/Cargo.toml
@@ -68,7 +68,7 @@ serde = [
 	"alloy-primitives/serde",
 	"rand?/serde",
 ]
-jwt = ["std", "dep:jsonwebtoken", "dep:rand"]
+jwt = ["std", "dep:jsonwebtoken", "dep:rand", "jsonwebtoken?/rust_crypto"]
 ssz = ["std", "dep:ethereum_ssz", "dep:ethereum_ssz_derive", "alloy-eips/ssz"]
 kzg = ["alloy-consensus/kzg", "alloy-eips/kzg"]
 arbitrary = ["dep:arbitrary", "std", "alloy-primitives/arbitrary", "alloy-serde/arbitrary", "alloy-consensus/arbitrary", "alloy-eips/arbitrary"]
-- 
2.53.0.vfs.0.0


