From 6d4c270630d09ec1d76cf08895b7b8aadc5c200f Mon Sep 17 00:00:00 2001
From: Vui-Chee <vuicheesiew@gmail.com>
Date: Wed, 25 Mar 2026 14:07:00 +0800
Subject: [PATCH 3/3] fix(rpc-types-engine): skip serializing None exp claim in
 JWT

jsonwebtoken 10.x validates the exp claim when present in the payload,
including when it's null. Without skip_serializing_if, exp: None
serializes as "exp": null which causes validation to fail.

Adding skip_serializing_if = "Option::is_none" ensures exp is omitted
from the JWT payload when None, matching the intended behavior.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 crates/rpc-types-engine/src/jwt.rs | 1 +
 1 file changed, 1 insertion(+)

diff --git a/crates/rpc-types-engine/src/jwt.rs b/crates/rpc-types-engine/src/jwt.rs
index aa06085d..a3aedb0e 100644
--- a/crates/rpc-types-engine/src/jwt.rs
+++ b/crates/rpc-types-engine/src/jwt.rs
@@ -130,6 +130,7 @@ pub struct Claims {
     pub iat: u64,
     /// The "exp" (expiration time) claim identifies the expiration time on or after which the JWT
     /// MUST NOT be accepted for processing.
+    #[cfg_attr(feature = "serde", serde(skip_serializing_if = "Option::is_none"))]
     pub exp: Option<u64>,
 }
 
-- 
2.53.0.vfs.0.0

